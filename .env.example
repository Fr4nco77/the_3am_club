# ==========================================
# CONFIGURACIÓN DE PROVEEDORES DE MENSAJERÍA
# ==========================================

# --- Telegram ---
# Obtén el token creando un bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN="tu_bot_token_aqui"
# ID del chat o grupo donde se recibirán los mensajes (obtenlo vía @userinfobot)
TELEGRAM_CHAT_ID="tu_chat_id_aqui"

# --- Resend (Opcional para cuando agregues Email) ---
# RESEND_API_KEY="re_123456789"

# --- Discord (Opcional) ---
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."